{
  "name": "codex-telegram-relay",
  "version": "0.1.5",
  "description": "A local, private-topic Telegram companion for existing Codex CLI sessions.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/data-will-be-here/codex-telegram-relay.git" },
  "engines": { "node": ">=22.13.0" },
  "bin": { "codex-telegram-relay": "dist/src/cli.js" },
  "files": ["dist/src/*.js", "docs", "README.md", "README.ru.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check:package": "node scripts/check-package.mjs",
    "start": "node dist/src/cli.js",
    "prepare": "npm run build"
  },
  "dependencies": { "marked": "18.1.2", "ws": "8.22.1" },
  "devDependencies": { "@types/node": "22.20.5", "@types/ws": "8.18.2", "typescript": "7.0.2" }
}
